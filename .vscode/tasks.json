{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Compilar Raylib",
            "command": "gcc",
            "args": [
                "${workspaceFolder}/*.c",
                "-o",
                "${workspaceFolder}\\main.exe",
                "-I${workspaceFolder}/include",
                "-L${workspaceFolder}/lib",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Tarefa para compilar C com Raylib no Windows"
        }
    ]
}